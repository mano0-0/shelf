# Copy to .env and fill in. .env is gitignored -- never commit real secrets.
#
#   cp .env.example .env

# The database. `docker compose up -d` starts one matching this.
DATABASE_URL=postgres://shelf:shelf@localhost:5433/shelf

# No default in code: the app refuses to start without this, rather than
# shipping a guessable signing key. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
